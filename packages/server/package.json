{
	"name": "twitter-api-safe-relay",
	"version": "0.2.1",
	"description": "HTTP relay server for safe Twitter/X web API requests through Playwright profiles.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fa0311/twitter_api_safe_relay.git",
		"directory": "packages/server"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./tools": {
			"types": "./src/tools.ts",
			"development": "./src/tools.ts",
			"import": "./dist/tools.js"
		}
	},
	"bin": {
		"twitter-api-safe-relay": "dist/server.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./tools": {
				"types": "./dist/tools.d.ts",
				"import": "./dist/tools.js"
			}
		}
	},
	"scripts": {
		"clean": "rimraf dist",
		"prebuild": "pnpm --filter twitter-api-safe-request build",
		"build": "pnpm clean && tsc -p tsconfig.json",
		"prepack": "pnpm build",
		"test": "vitest run",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"keywords": [
		"twitter",
		"x",
		"hono",
		"playwright",
		"relay"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@hono/node-server": "^2.0.10",
		"@inquirer/prompts": "^8.5.2",
		"boxen": "^8.0.1",
		"chalk": "^5.6.2",
		"commander": "^15.0.0",
		"error-stack-parser": "^2.1.4",
		"hono": "^4.11.0",
		"jsonc-parser": "^3.3.1",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.60.0",
		"twitter-api-safe-relay-dashboard": "workspace:*",
		"twitter-api-safe-request": "workspace:*",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@types/node": "^25.0.2",
		"rimraf": "^6.1.3",
		"twitter-api-safe-test-utils": "workspace:*",
		"typescript": "^5.9.3",
		"vitest": "^4.1.5"
	}
}
