{
	"name": "twitter-api-safe-relay-dashboard",
	"version": "0.2.1",
	"description": "Vite dashboard UI for inspecting Twitter/X web API requests captured through twitter-api-safe-request.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fa0311/twitter_api_safe_relay.git",
		"directory": "packages/dashboard"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		}
	},
	"files": [
		"dist",
		"index.js",
		"index.d.ts",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "rimraf dist",
		"dev": "vite",
		"build": "pnpm clean && vite build",
		"prepack": "pnpm build",
		"test": "vitest run",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"keywords": [
		"twitter",
		"x",
		"vite",
		"react",
		"dashboard",
		"debug"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"codemirror": "^6.0.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"rimraf": "^6.1.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"zod": "^4.6.7",
		"zustand": "^5.0.15"
	}
}
