{
	"name": "twitter-api-safe-relay-dashboard",
	"version": "0.0.2",
	"description": "Vite dashboard UI for inspecting Twitter/X web API requests captured through twitter-api-safe-request.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fa0311/twitter_api_safe_relay.git",
		"directory": "packages/dashboard"
	},
	"type": "module",
	"bin": {
		"twitter-api-safe-dashboard": "server-dist/server.js"
	},
	"files": [
		"dist",
		"server-dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "rimraf dist server-dist",
		"dev": "vite",
		"build": "pnpm clean && vite build && tsc -p tsconfig.server.json",
		"prepack": "pnpm build",
		"test": "vitest run",
		"type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
		"verify": "pnpm exec biome lint . && pnpm type-check && pnpm test && pnpm build"
	},
	"keywords": [
		"twitter",
		"x",
		"vite",
		"react",
		"dashboard",
		"debug"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@hono/node-server": "^1.19.4",
		"hono": "^4.11.0",
		"twitter-api-safe-relay": "workspace:*"
	},
	"devDependencies": {
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"codemirror": "^6.0.2",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"zod": "^4.1.13",
		"zustand": "^5.0.13",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^25.0.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"rimraf": "^6.1.3",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.3",
		"vite": "^8.0.11",
		"vitest": "^4.1.5"
	}
}
