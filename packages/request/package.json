{
	"name": "twitter-api-safe-request",
	"version": "0.1.1",
	"description": "Safe request helpers for Twitter/X web API access through a Playwright profile.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fa0311/twitter_api_safe_relay.git",
		"directory": "packages/request"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "pnpm clean && tsc -p tsconfig.json",
		"prepack": "pnpm build",
		"test": "vitest run",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"keywords": [
		"twitter",
		"x",
		"playwright",
		"api"
	],
	"author": "",
	"license": "MIT",
	"peerDependencies": {
		"playwright": ">=1.60.0 <2"
	},
	"dependencies": {
		"twitter-api-safe-inject": "workspace:*"
	},
	"devDependencies": {
		"twitter-api-safe-test-utils": "workspace:*",
		"@types/node": "^25.0.2",
		"playwright": "^1.60.0",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.5"
	}
}
