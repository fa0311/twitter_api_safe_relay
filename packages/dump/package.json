{
	"name": "twitter-api-safe-dump",
	"version": "0.1.0",
	"description": "Records the requests the Twitter/X web app sends while browsing a logged-in profile, as the requests.ndjson catalog served by twitter-api-safe-relay.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fa0311/twitter_api_safe_relay.git",
		"directory": "packages/dump"
	},
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"twitter-api-safe-dump": "dist/dump.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "rimraf dist",
		"prebuild": "pnpm --filter twitter-api-safe-request build",
		"build": "pnpm clean && tsc -p tsconfig.json",
		"prepack": "pnpm build",
		"test": "vitest run",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"keywords": [
		"twitter",
		"x",
		"playwright",
		"catalog"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"playwright": "^1.64.0",
		"twitter-api-safe-request": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	}
}
