{
	"name": "twitter-api-safe-wxt",
	"version": "0.0.1",
	"description": "Minimal WXT bridge for the Twitter/X Web App API client.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fa0311/twitter_api_safe_proxy.git",
		"directory": "packages/wxt"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./module": {
			"types": "./src/module.ts",
			"development": "./src/module.ts",
			"import": "./src/module.ts"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./module": {
				"types": "./dist/module.d.ts",
				"import": "./dist/module.js"
			}
		}
	},
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"verify": "pnpm exec biome lint . && pnpm type-check && pnpm build"
	},
	"keywords": [
		"twitter",
		"x",
		"wxt",
		"browser-extension"
	],
	"license": "MIT",
	"peerDependencies": {
		"wxt": ">=0.20.27 <1"
	},
	"dependencies": {
		"twitter-api-safe-inject": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"wxt": "0.20.27"
	}
}
