{
	"name": "twitter-api-safe-mcp",
	"version": "0.0.4",
	"description": "MCP server for safe Twitter/X web API requests through Playwright profiles, in a single process.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fa0311/twitter_api_safe_relay.git",
		"directory": "packages/mcp"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"twitter-api-safe-mcp": "dist/server.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"clean": "rimraf dist",
		"prebuild": "pnpm --filter twitter-api-safe-relay build",
		"build": "pnpm clean && tsc -p tsconfig.json",
		"prepack": "pnpm build",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"keywords": [
		"twitter",
		"x",
		"mcp",
		"playwright"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.25.0",
		"twitter-api-safe-relay": "workspace:*",
		"twitter-api-safe-request": "workspace:*",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@types/node": "^25.0.2",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3"
	}
}
