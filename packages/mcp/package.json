{
	"name": "twitter-api-safe-mcp",
	"version": "0.2.1",
	"description": "MCP server for safe Twitter/X web API requests through Playwright profiles, in a single process.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fa0311/twitter_api_safe_relay.git",
		"directory": "packages/mcp"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"twitter-api-safe-mcp": "dist/server.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"clean": "rimraf dist",
		"prebuild": "pnpm --filter twitter-api-safe-relay build",
		"build": "pnpm clean && tsc -p tsconfig.json",
		"prepack": "pnpm build",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"keywords": [
		"twitter",
		"x",
		"mcp",
		"playwright"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@hono/mcp": "^0.3.2",
		"@hono/node-server": "^2.1.5",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"hono": "^4.13.13",
		"jq-wasm": "3.0.0-jq-1.8.2",
		"ts-pattern": "^5.9.2",
		"twitter-api-safe-relay": "workspace:*",
		"twitter-api-safe-relay-dashboard": "workspace:*",
		"twitter-api-safe-request": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	}
}
