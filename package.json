{
	"name": "twitter-api-safe-workspace",
	"version": "1.0.0",
	"description": "Workspace for Twitter/X Web App API clients, adapters, and relay packages.",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r run build",
		"predev:relay": "pnpm --filter twitter-api-safe-request build",
		"dev:relay": "tsx watch packages/server/src/server.ts",
		"predev:relay:debug": "pnpm --filter twitter-api-safe-request build",
		"dev:relay:debug": "tsx watch packages/server/src/debug/server.ts",
		"dev:dashboard": "pnpm --filter twitter-api-safe-dashboard dev",
		"dev:wxt": "pnpm --filter twitter-api-safe-example-basic dev",
		"test": "pnpm -r run test",
		"type-check": "pnpm -r run type-check",
		"lint": "biome lint .",
		"format": "biome format --write ."
	},
	"keywords": [
		"typescript",
		"playwright",
		"automation"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/node": "^25.0.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@11.5.0"
}
